HYDRA_DB_API_KEY=your_hydradb_key
HYDRA_DATABASE=whybot
HYDRA_COLLECTION=company_knowledge

# ---- LLM (pick ONE; all optional — without one you get a clean evidence summary) ----
# Option A: Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Option B: any OpenAI-compatible provider. Free choices:
#   Groq (free key: console.groq.com)        OPENAI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_MODEL=llama-3.3-70b-versatile
#   Gemini (free key: aistudio.google.com)   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   OPENAI_MODEL=gemini-2.5-flash
#   Ollama (local, no key: `ollama pull llama3.2`)  OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3.2
#   OpenAI                                    leave OPENAI_BASE_URL empty, OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# 1 = offline demo with no network (stage safety net)
MOCK_MODE=0

# Tuning (optional)
# Reuse identical answers for 10 min (auto-invalidated when docs or memories change)
CACHE_TTL_S=600
# Blast-radius traversal depth
MAX_HOPS=3
MAX_UPLOAD_MB=20
CORS_ORIGINS=*
